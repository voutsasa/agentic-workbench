# Unit-test directories the pre-push hook runs, one per line, each with
# `python -m unittest discover -s <dir> -t <dir>` on the repo's .venv interpreter.
#
# This file is repo-local and tracked on purpose, for the same reason as
# .verify-claims-allow: the hook lives in the globally symlinked skills tree and
# serves every repo that links it, so a directory named in the hook would be
# looked for in unrelated repos. No file means no tests run.

# The workstation scripts' own tests, and test_readme_skills.py, which fails when
# README.md's skill table stops matching link_config.py's SKILLS tuple and the
# skills/ folders, and test_python_version.py, which fails when .python-version
# stops satisfying requires-python in pyproject.toml, or when status.py's Python
# floor in workstation/dependencies.toml stops matching it.
workstation/scripts/tests

# The skills' own suites — this repo's and the global ones it versions. review's
# suite runs the hook itself; PRE_PUSH_IN_TESTS stops that nested run from
# starting these suites again.
skills/setup-agents/tests
workstation/agent/skills/fetch-to-markdown/tests
workstation/agent/skills/python-quality/tests
workstation/agent/skills/review/tests
workstation/agent/skills/setup-mcp-servers/tests
workstation/agent/skills/verify-docs/tests

# The post-edit hook scripts linked by link_config.py --hooks.
workstation/agent/hooks/tests
