{
  "mcpServers": {
    "drawio-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@drawio/mcp"],
      "env": {}
    },
    "ado-remote-mcp": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/euemadev",
      "headers": {
        "X-MCP-Readonly": "true"
      }
    },
    "atlassian-mcp": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    }
  }
}
