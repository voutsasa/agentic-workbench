#!/usr/bin/env bash
#
# Pre-push gate. Five checks, all deterministic, none calling a model and none
# touching the network:
#
#   1. repo_check.py    — is the prose internally consistent? Whole repo.
#   2. ruff             — `ruff check` and `ruff format --check`, only in a repo
#                         with a .pre-push-ruff file at its root.
#   3. pyright          — `python -m pyright`, only in a repo with a
#                         .pre-push-pyright file at its root.
#   4. unit tests       — the directories the repo names in .pre-push-tests.
#                         No file, no tests.
#   5. verify_claims.py — is each claim still true? Only the markdown being
#                         pushed.
#
# Every step runs on the pushed repo's .venv interpreter; python on PATH
# (python3 outside Windows) only when the repo has no .venv, and the hook says
# so. repo_check.py and verify_claims.py are found beside this script (after following symlinks), so
# the hook works from any repo that links it; without them, steps 2-4 still run.
#
# Install (from the repo root):
#   ln -sf ../../workstation/agent/skills/review/scripts/pre-push .git/hooks/pre-push
#
# The symlink keeps the hook versioned — .git/hooks is not tracked, so a copied
# hook silently rots and never reaches a fresh clone.
#
# Why the fifth check is scoped to changed files: verifying every claim in the
# repo varies by corpus and toolchain, because it executes `--help` for every
# documented tool. Scoped to what is actually being pushed it is typically under
# a second, and a claim you did not touch is one you did not break. Run the full
# sweep on demand instead:
#
#   .venv/bin/python workstation/agent/skills/verify-docs/scripts/verify_claims.py --repo .
#   …--online     also checks external URLs and package registries
#   …--strict     UNVERIFIABLE fails too, not just REFUTED
#
# Escape hatches, in order of preference:
#   edit .verify-claims-allow      — exempt a path that is meant not to exist
#   edit .verify-flags-allow       — exempt a flag no help text documents
#   SKIP_VERIFY_CLAIMS=1 git push  — skip the claim verifier, keep the rest
#   SKIP_PRE_PUSH_TESTS=1 git push — skip the unit tests, keep the rest
#   SKIP_RUFF=1 git push           — skip ruff, keep the rest
#   SKIP_PYRIGHT=1 git push        — skip Pyright, keep the rest
#   SKIP_REPO_CHECK=1 git push     — skip every check in this hook
#   git push --no-verify           — skip every hook in the repository
#
# Reach for the narrowest one that unblocks you. A claim that is REFUTED because
# a tool is genuinely absent on this machine already reports UNVERIFIABLE and
# does not block; a REFUTED row means the documentation and reality disagree.

set -uo pipefail

if [ "${SKIP_REPO_CHECK:-0}" = "1" ]; then
  echo "pre-push: SKIP_REPO_CHECK=1 — skipping the documentation gate." >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0

# The checkers live beside this script, not in the repo being pushed: one copy
# of the hook serves every repo that links it, and only the workbench has a
# `workstation/` tree. So resolve this file's real location first — .git/hooks/
# pre-push is a symlink on macOS, and on Windows pre-push.windows execs the
# tracked file (or the globally linked skill) by path. A readlink loop rather
# than `readlink -f`, which macOS only gained in 12.3.
SELF="${BASH_SOURCE[0]//\\//}"                    # C:\a\b → C:/a/b on Windows
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *) case "$SELF" in */*) SELF="${SELF%/*}/$link" ;; *) SELF="$link" ;; esac ;;
  esac
done
case "$SELF" in */*) SCRIPT_DIR="${SELF%/*}" ;; *) SCRIPT_DIR="." ;; esac
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd -P)"
CHECKER="$SCRIPT_DIR/repo_check.py"
VERIFIER="$(cd "$SCRIPT_DIR/../.." && pwd -P)/verify-docs/scripts/verify_claims.py"

# The repo's own venv when it has one, so every step — the gates as well as
# ruff and the suites — runs on the interpreter the project pins.
PYTHON=""
for candidate in "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/.venv/Scripts/python.exe"; do
  if [ -x "$candidate" ]; then
    PYTHON="$candidate"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  # Windows names its interpreter python; python3 there is absent or a Store stub.
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) PYTHON=python ;;
    *) PYTHON=python3 ;;
  esac
  echo "pre-push: no .venv interpreter in $REPO_ROOT — falling back to $PYTHON on PATH." >&2
fi

if [ ! -f "$CHECKER" ]; then
  echo "pre-push: checker not found at $CHECKER — skipping the documentation" >&2
  echo "          check. The steps this repo opted into still run." >&2
elif [ -z "$(git -C "$REPO_ROOT" ls-files -- '*.md' | head -n 1)" ]; then
  # A code-only repo has nothing for the gate to read, and the checker refuses
  # an empty scope; that refusal is for a misconfigured scope, not this.
  echo "pre-push: no tracked markdown — skipping the documentation check." >&2
else
  # The checker cannot need Git's ref list; reserve that stdin for the loop
  # below. This also prevents a checker subprocess from consuming the list.
  "$PYTHON" "$CHECKER" --repo-root "$REPO_ROOT" < /dev/null
  status=$?

  case "$status" in
    0) ;;
    1) echo "" >&2
       echo "pre-push: push refused — fix the violations above, or bypass with" >&2
       echo "          SKIP_REPO_CHECK=1 git push" >&2
       exit "$status" ;;
    *) echo "" >&2
       echo "pre-push: the gate could not run (exit $status). Refusing rather than" >&2
       echo "          assuming a pass. Bypass with SKIP_REPO_CHECK=1 git push" >&2
       exit "$status" ;;
  esac
fi

# git calls this hook with two arguments, the destination remote's name and its
# location (githooks(5)); a hand run passes none. That is the reliable test for
# "git is not driving me", and `[ -t 0 ]` is not: stdin may be a pipe or
# /dev/null in an agent session and still carry no ref list.
#
# The guard belongs before the unit-test step as well as the ref-list loop. A
# hand-run hook must not recursively start this test suite before explaining
# that only the documentation check ran.
if [ "$#" -lt 2 ]; then
  echo "" >&2
  echo "pre-push: no ref list on stdin — not invoked by git." >&2
  echo "          Only repo_check.py ran above: ruff, Pyright, the unit tests and" >&2
  echo "          verify_claims.py did NOT run." >&2
  echo "          For the claim check: $PYTHON $VERIFIER --repo $REPO_ROOT" >&2
  exit 0
fi

# --- ruff, in repos that opt in with .pre-push-ruff -----------------------------

# Opt-in by file, like .pre-push-tests, because one copy of this hook serves every
# repo that links it: a repo that never asked for lint must not start refusing
# pushes. `-m ruff` rather than a path to the binary, so one line serves the
# POSIX and the Windows venv layouts. Both commands run before deciding, so one
# push shows every violation.
if [ -f "$REPO_ROOT/.pre-push-ruff" ]; then
  if [ "${SKIP_RUFF:-0}" = "1" ]; then
    echo "pre-push: SKIP_RUFF=1 — skipping ruff." >&2
  else
    echo "pre-push: ruff check and ruff format --check" >&2
    (cd "$REPO_ROOT" && "$PYTHON" -m ruff check . < /dev/null)
    lint=$?
    (cd "$REPO_ROOT" && "$PYTHON" -m ruff format --check . < /dev/null)
    fmt=$?
    if [ "$lint" -ne 0 ] || [ "$fmt" -ne 0 ]; then
      echo "" >&2
      echo "pre-push: push refused — ruff reported the problems above (or could not" >&2
      echo "          run: is ruff in the repo's .venv?). Fix them, or bypass with" >&2
      echo "          SKIP_RUFF=1 git push" >&2
      exit 1
    fi
  fi
fi

# --- Pyright, in repos that opt in with .pre-push-pyright ----------------------

# Pyright's generated console launcher can be blocked by endpoint protection.
# The venv interpreter's module route is portable across macOS and Windows and
# runs the same installed package.
if [ -f "$REPO_ROOT/.pre-push-pyright" ]; then
  if [ "${SKIP_PYRIGHT:-0}" = "1" ]; then
    echo "pre-push: SKIP_PYRIGHT=1 — skipping Pyright." >&2
  else
    echo "pre-push: Pyright" >&2
    (cd "$REPO_ROOT" && "$PYTHON" -m pyright < /dev/null)
    status=$?
    if [ "$status" -ne 0 ]; then
      echo "" >&2
      echo "pre-push: push refused — Pyright reported the problems above (or could not" >&2
      echo "          run: is pyright in the repo's .venv?). Fix them, or bypass with" >&2
      echo "          SKIP_PYRIGHT=1 git push" >&2
      exit "$status"
    fi
  fi
fi

# --- unit tests, in the directories the pushed repo names -----------------------

# Which suites run comes from .pre-push-tests in the repo being pushed, never from
# this file, for the same reason as .verify-claims-allow below: one copy of this
# hook serves every repo that links it. Absent the file, no tests run.
#
# PRE_PUSH_IN_TESTS is set for the suites started here. A suite that invokes this
# hook itself — review's test_pre_push.py does — then skips this step instead of
# starting the suites again from inside them.
TESTS_FILE="$REPO_ROOT/.pre-push-tests"
if [ "${SKIP_PRE_PUSH_TESTS:-0}" = "1" ]; then
  echo "pre-push: SKIP_PRE_PUSH_TESTS=1 — skipping unit tests." >&2
elif [ -f "$TESTS_FILE" ] && [ -z "${PRE_PUSH_IN_TESTS:-}" ]; then
  while IFS= read -r dir || [ -n "$dir" ]; do
    dir="${dir%%#*}"                                    # drop trailing comments
    dir="${dir#"${dir%%[![:space:]]*}"}"                # trim leading space
    dir="${dir%"${dir##*[![:space:]]}"}"                # trim trailing space
    [ -z "$dir" ] && continue

    if [ ! -d "$REPO_ROOT/$dir" ]; then
      echo "pre-push: '$dir', named in .pre-push-tests, is not a directory." >&2
      echo "          Refusing rather than skipping a suite. Fix the file, or bypass with" >&2
      echo "          SKIP_PRE_PUSH_TESTS=1 git push" >&2
      exit 2
    fi

    echo "pre-push: unit tests in $dir" >&2
    # -b holds a test's own output back unless it fails: a suite printing from a
    # temporary tree would otherwise read as this machine's state. stdin is
    # /dev/null so nothing a test reads can consume this loop's file or git's
    # ref list.
    PRE_PUSH_IN_TESTS=1 "$PYTHON" -m unittest discover -q -b \
      -s "$REPO_ROOT/$dir" -t "$REPO_ROOT/$dir" < /dev/null
    status=$?

    case "$status" in
      0) ;;
      5) echo "" >&2
         echo "pre-push: no tests found in $dir. Refusing rather than assuming a pass." >&2
         echo "          Bypass with SKIP_PRE_PUSH_TESTS=1 git push" >&2
         exit "$status" ;;
      *) echo "" >&2
         echo "pre-push: push refused — tests in $dir failed. Fix them, or bypass with" >&2
         echo "          SKIP_PRE_PUSH_TESTS=1 git push" >&2
         exit "$status" ;;
    esac
  done < "$TESTS_FILE"
fi

# --- claim verification, scoped to the markdown in this push -------------------

if [ "${SKIP_VERIFY_CLAIMS:-0}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY_CLAIMS=1 — skipping claim verification." >&2
  exit 0
fi

if [ ! -f "$VERIFIER" ]; then
  exit 0            # the verifier is optional; repo_check has already passed
fi

# Exemptions are not this hook's business. `.verify-claims-allow` and
# `.verify-flags-allow` are read by the verifier itself, from the repo it is
# given — this hook used to parse the first of them and pass each glob back as
# `--allow`, which was a second parser of one file format and a second place to
# state the policy. It announces what it waived, so the report and the notice
# cannot disagree. `--no-allow-file` there is what ignores them; nothing here.

# git feeds the hook "<local ref> <local sha> <remote ref> <remote sha>" per ref.
# A remote sha of all zeros means the branch is new there, so compare against the
# remote's default branch — its HEAD when known, else main, else master — and
# against the parent, or the empty tree for a root commit, when none of those
# shares history with it. A diff that cannot run refuses the push: hiding its
# error once let a push pass having checked nothing.
ZERO="0000000000000000000000000000000000000000"
REMOTE="$1"
EMPTY_TREE="$(git hash-object -t tree --stdin < /dev/null)"

default_ref() {
  local ref
  if ref="$(git symbolic-ref -q "refs/remotes/$REMOTE/HEAD" 2>/dev/null)"; then
    printf '%s\n' "$ref"
    return
  fi
  for ref in refs/heads/main refs/heads/master; do
    if git rev-parse -q --verify "$ref" > /dev/null; then
      printf '%s\n' "$ref"
      return
    fi
  done
}

changed=""
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # a deletion carries no files
  if [ "${remote_sha:-$ZERO}" = "$ZERO" ]; then
    base=""
    ref="$(default_ref)"
    [ -n "$ref" ] && base="$(git merge-base "$local_sha" "$ref" 2>/dev/null)"
    if [ -z "$base" ]; then
      if git rev-parse -q --verify "$local_sha^" > /dev/null; then
        base="$local_sha^"
      else
        base="$EMPTY_TREE"                          # a root commit: every file is new
      fi
    fi
  else
    base="$remote_sha"
  fi
  if ! diff_out="$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.md')"; then
    echo "" >&2
    echo "pre-push: cannot diff $base..$local_sha for $local_ref, so the claim" >&2
    echo "          check cannot tell what is being pushed. Refusing rather than" >&2
    echo "          assuming a pass. Fetch first, or bypass with" >&2
    echo "          SKIP_VERIFY_CLAIMS=1 git push" >&2
    exit 2
  fi
  changed+="$diff_out"$'\n'
done

# Deduplicate, drop blanks, and keep only files that still exist in the worktree.
# Pure-bash dedup rather than `sort -u`: an EDR policy on at least one machine
# (Windows, git's bundled usr/bin run from an agent session) blocks that binary
# by name+location, and a hook that silently sees zero files on such a machine
# is worse than one that doesn't need the binary at all.
#
# A delimited string, not an associative array: `declare -A` is bash 4, and
# macOS ships bash 3.2, where it fails and every `${_seen[$file]}` after it is
# an arithmetic error — leaving `files` empty and the hook exiting 0 with
# nothing checked. That is the same silent pass this block exists to avoid, so
# the dedup uses only constructs bash 3.2 has. A path cannot contain a newline
# here (git would quote it), so \n is a safe delimiter.
_seen=$'\n'
files=()
while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$_seen" in *$'\n'"$file"$'\n'*) continue ;; esac
  _seen="$_seen$file"$'\n'
  [ -f "$REPO_ROOT/$file" ] && files+=("$file")
done < <(printf '%s\n' "$changed")

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

"$PYTHON" "$VERIFIER" --repo "$REPO_ROOT" --files "${files[@]}"
status=$?

case "$status" in
  0) ;;
  1) echo "" >&2
     echo "pre-push: push refused — the REFUTED claims above contradict reality." >&2
     echo "          Fix the documentation, or bypass with" >&2
     echo "          SKIP_VERIFY_CLAIMS=1 git push" >&2 ;;
  *) echo "" >&2
     echo "pre-push: the claim verifier could not run (exit $status). Refusing" >&2
     echo "          rather than assuming a pass. Bypass with" >&2
     echo "          SKIP_VERIFY_CLAIMS=1 git push" >&2 ;;
esac

exit $status
