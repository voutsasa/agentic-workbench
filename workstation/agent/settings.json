{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "fastMode": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-$PWD}/.venv/bin/python\"; [ -x \"$p\" ] || exit 0; \"$p\" ~/.claude/hooks/ruff_on_edit.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
